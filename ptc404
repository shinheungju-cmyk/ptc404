  </div>
  <div id="success-modal" class="modal-backdrop" hidden="" role="dialog" aria-modal="true" aria-labelledby="success-heading">
   <div class="modal-box glass rounded-3xl p-8 text-center">
    <div class="text-5xl mb-5 text-[#7759df]" aria-hidden="true">
     ✓
    </div>
    <h2 id="success-heading" data-template-id="success-title" class="canva-text font-bold mb-3" style="color: rgb(38, 51, 84); font-weight: 700; font-style: normal; font-size: 24px;">주문이 완료되었습니다</h2>
    <p data-template-id="success-description" class="canva-text mb-5" style="color: rgb(88, 101, 130); font-weight: 400; font-style: normal; font-size: 16px;">아래 QR 코드와 주문번호를 확인해 주세요.</p>
    <div id="qr-holder" class="bg-white rounded-xl w-fit mx-auto p-3 mb-5">
     <canvas id="order-qr" role="img" aria-label="주문 정보 QR 코드"></canvas>
    </div>
    <p id="qr-fallback" class="text-[#586582] mb-3" hidden="">QR 코드를 표시할 수 없습니다. 아래 주문번호를 확인해 주세요.</p>
    <p id="success-order" class="font-bold break-all mb-2"></p>
    <p id="success-total" class="text-[#7759df] mb-6"></p><button id="success-close" data-template-id="success-close-label" class="canva-button action" type="button" style="background: rgb(86, 108, 233); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 16px;">쇼핑 계속하기</button>
   </div>
  </div>
  <div id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 bg-[#554bc8] text-white rounded-xl px-5 py-3 font-semibold z-[70] shadow-xl max-w-[90%]" role="status" aria-live="polite" hidden=""></div>
  <script>
(() => {
  'use strict';
  const KEY='protocol404-store-v1';
  const seed={
    categories:[{id:'cat-lifestyle',name:'라이프스타일'},{id:'cat-wellness',name:'웰니스'},{id:'cat-goods',name:'굿즈'}],
    products:[
      {id:'p-tea',categoryId:'cat-wellness',name:'프리미엄 허브 티',price:18000,stock:24,image:'https://images.pexels.com/photos/29387167/pexels-photo-29387167.jpeg',description:'하루의 호흡을 고르게 만드는 향긋한 허브 블렌드.'},
      {id:'p-tumbler',categoryId:'cat-lifestyle',name:'에코 텀블러',price:29000,stock:18,image:'https://images.pexels.com/photos/7262742/pexels-photo-7262742.jpeg',description:'일상의 작은 변화를 위한 재사용 가능한 텀블러.'},
      {id:'p-green-tea',categoryId:'cat-wellness',name:'그린 티 셀렉션',price:22000,stock:12,image:'https://images.pexels.com/photos/27509157/pexels-photo-27509157.jpeg',description:'싱그러운 잎의 풍미를 담은 프리미엄 티 셀렉션.'}
    ],cart:[],orders:[]
  };
  const $=id=>document.getElementById(id);
  const won=n=>new Intl.NumberFormat('ko-KR',{style:'currency',currency:'KRW',maximumFractionDigits:0}).format(n);
  const uid=()=>crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random().toString(36).slice(2);
  let state;
  try{const raw=localStorage.getItem(KEY),saved=raw?JSON.parse(raw):null;state=saved&&Array.isArray(saved.categories)&&Array.isArray(saved.products)&&Array.isArray(saved.cart)&&Array.isArray(saved.orders)?saved:structuredClone(seed)}
  catch{state=structuredClone(seed)}
  function persist(){try{localStorage.setItem(KEY,JSON.stringify(state));return true}catch{toast('브라우저 저장에 실패했습니다. 저장 공간을 확인해 주세요.');return false}}
  if(!localStorage.getItem(KEY))persist();
  let categoryFilter='all',editingCategory=null,editingProduct=null,detailId=null,lastFocus=null,toastTimer;
  function toast(message){const el=$('toast');el.textContent=message;el.hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.hidden=true,3500)}
  function node(tag,cls,text){const el=document.createElement(tag);if(cls)el.className=cls;if(text!==undefined)el.textContent=text;return el}
  function button(text,handler,cls='subaction'){const el=node('button',cls,text);el.type='button';el.addEventListener('click',handler);return el}
  function categoryName(id){return state.categories.find(c=>c.id===id)?.name||'미분류'}
  function cleanCart(){state.cart=state.cart.filter(item=>state.products.some(p=>p.id===item.id&&p.stock>0)).map(item=>({id:item.id,quantity:Math.min(item.quantity,state.products.find(p=>p.id===item.id).stock)}))}
  function renderFilters(){
    const box=$('category-filters');box.replaceChildren();
    for(const item of [{id:'all',name:'전체 보기'},...state.categories]){
      const b=button(item.name,()=>{categoryFilter=item.id;renderFilters();renderProducts()},'chip subaction whitespace-nowrap');
      b.setAttribute('aria-pressed',String(categoryFilter===item.id));box.append(b)
    }
  }
  function renderProducts(){
    const list=$('product-grid');list.replaceChildren();
    const products=state.products.filter(p=>categoryFilter==='all'||p.categoryId===categoryFilter);
    $('result-count').textContent=`상품 ${products.length}개`;$('product-empty').hidden=products.length>0;
    for(const p of products){
      const card=node('article','glass rounded-3xl overflow-hidden reveal');
      const img=node('img','product-photo');img.src=p.image;img.alt=p.name;img.loading='lazy';img.onerror=()=>{img.onerror=null;img.style.display='none'};
      const content=node('div','p-5');
      content.append(node('p','text-[#7759df] text-sm font-bold mb-2',categoryName(p.categoryId)),node('h3','font-bold mb-2',p.name),node('p','text-[#586582] text-sm line-clamp-2 min-h-10',p.description));
      const foot=node('div','flex items-center justify-between gap-3 mt-5');
      foot.append(node('strong','',won(p.price)),button(p.stock?'자세히 보기':'품절',()=>openDetail(p.id),'action text-sm'));
      if(!p.stock)foot.lastChild.disabled=true;
      content.append(foot);card.append(img,content);list.append(card)
    }
  }
  function renderCart(){
    cleanCart();const box=$('cart-items');box.replaceChildren();let total=0,count=0;
    for(const item of state.cart){
      const p=state.products.find(x=>x.id===item.id);if(!p)continue;
      total+=p.price*item.quantity;count+=item.quantity;
      const row=node('div','border border-[#d9dff4] bg-white/70 rounded-xl p-4 flex flex-wrap justify-between gap-3');
      const info=node('div');info.append(node('strong','block',p.name),node('span','text-[#586582] text-sm',`${won(p.price)} · 최대 ${p.stock}개`));
      const controls=node('div','flex items-center gap-2');
      controls.append(button('−',()=>changeQuantity(p.id,-1),'subaction px-3'),node('span','min-w-6 text-center',String(item.quantity)),button('+',()=>changeQuantity(p.id,1),'subaction px-3'),button('삭제',()=>{state.cart=state.cart.filter(x=>x.id!==p.id);persist();renderCart()},'subaction text-sm'));
      row.append(info,controls);box.append(row)
    }
    $('cart-count').textContent=count;$('cart-total').textContent=won(total);$('cart-empty').hidden=count!==0;$('checkout').disabled=count===0
  }
  function changeQuantity(id,delta){
    const item=state.cart.find(x=>x.id===id),p=state.products.find(x=>x.id===id);if(!item||!p)return;
    if(item.quantity+delta>p.stock){toast('재고 수량을 초과할 수 없습니다.');return}
    if(item.quantity+delta<=0)state.cart=state.cart.filter(x=>x.id!==id);else item.quantity+=delta;
    persist();renderCart()
  }
  function renderSeller(){
    const categories=$('seller-categories');categories.replaceChildren();
    for(const c of state.categories){
      const row=node('div','flex items-center justify-between gap-2 border border-[#d9dff4] bg-white/60 rounded-xl p-3');
      row.append(node('span','font-semibold break-all',c.name));
      const actions=node('div','flex gap-2 shrink-0');
      actions.append(button('수정',()=>{editingCategory=c.id;$('category-name').value=c.name;$('category-name').focus();$('category-cancel').hidden=false},'subaction text-sm'),button('삭제',()=>confirmInline(actions,()=>{state.categories=state.categories.filter(x=>x.id!==c.id);state.products.forEach(p=>{if(p.categoryId===c.id)p.categoryId=''});if(categoryFilter===c.id)categoryFilter='all';if(editingCategory===c.id)resetCategoryForm();persist();renderAll();toast('카테고리를 삭제했습니다.')})));
      row.append(actions);categories.append(row)
    }
    const select=$('product-category'),previous=select.value;select.replaceChildren();select.append(new Option('미분류',''));
    for(const c of state.categories)select.append(new Option(c.name,c.id));
    select.value=[...select.options].some(o=>o.value===previous)?previous:'';
    const products=$('seller-products');products.replaceChildren();
    if(!state.products.length)products.append(node('p','glass p-5 rounded-xl text-[#586582]','등록된 상품이 없습니다.'));
    for(const p of state.products){
      const row=node('article','glass p-4 rounded-xl flex flex-wrap items-center justify-between gap-3');
      const info=node('div');info.append(node('strong','block',p.name),node('span','text-[#586582] text-sm',`${categoryName(p.categoryId)} · ${won(p.price)} · 재고 ${p.stock}개`));
      const actions=node('div','flex gap-2');actions.append(button('수정',()=>editProduct(p.id)),button('삭제',()=>confirmInline(actions,()=>{state.products=state.products.filter(x=>x.id!==p.id);state.cart=state.cart.filter(x=>x.id!==p.id);if(editingProduct===p.id)resetProductForm();persist();renderAll();toast('상품을 삭제했습니다.')})));
      row.append(info,actions);products.append(row)
    }
    const orders=$('seller-orders');orders.replaceChildren();
    if(!state.orders.length)orders.append(node('p','glass p-5 rounded-xl text-[#586582]','아직 접수된 주문이 없습니다.'));
    for(const o of [...state.orders].reverse()){
      const row=node('article','glass p-4 rounded-xl');
      row.append(node('strong','block break-all',o.id),node('p','text-[#586582] text-sm mt-1',`${new Date(o.createdAt).toLocaleString('ko-KR')} · ${o.items.map(i=>`${i.name} × ${i.quantity}`).join(', ')}`),node('p','text-[#7759df] font-bold mt-2',won(o.total)));orders.append(row)
    }
  }
  function confirmInline(holder,action){holder.replaceChildren();holder.append(button('삭제 확인',action,'action text-sm'),button('취소',()=>renderSeller(),'subaction text-sm'))}
  function renderAll(){renderFilters();renderProducts();renderCart();renderSeller()}
  function resetCategoryForm(){editingCategory=null;$('category-form').reset();$('category-cancel').hidden=true}
  function resetProductForm(){editingProduct=null;$('product-form').reset();$('product-cancel').hidden=true}
  function editProduct(id){
    const p=state.products.find(x=>x.id===id);if(!p)return;
    editingProduct=id;$('product-name').value=p.name;$('product-category').value=p.categoryId;$('product-price').value=p.price;$('product-stock').value=p.stock;$('product-image').value=p.image;$('product-description').value=p.description;$('product-cancel').hidden=false;
    $('product-form').scrollIntoView({behavior:'smooth',block:'center'});$('product-name').focus()
  }
  function openModal(id){lastFocus=document.activeElement;$(id).hidden=false;document.body.style.overflow='hidden';$(id).querySelector('button')?.focus()}
  function closeModal(id){$(id).hidden=true;document.body.style.overflow='';lastFocus?.focus()}
  function openDetail(id){
    const p=state.products.find(x=>x.id===id);if(!p)return;detailId=id;
    $('detail-image').src=p.image;$('detail-image').alt=p.name;$('detail-category').textContent=categoryName(p.categoryId);$('detail-name').textContent=p.name;$('detail-description').textContent=p.description;$('detail-price').textContent=won(p.price);$('detail-stock').textContent=`재고 ${p.stock}개`;$('detail-quantity').value=1;$('detail-quantity').max=p.stock;openModal('detail-modal')
  }
  function switchMode(mode){$('buyer-view').hidden=mode!=='buyer';$('seller-view').hidden=mode!=='seller';$('buyer-mode').setAttribute('aria-pressed',String(mode==='buyer'));$('seller-mode').setAttribute('aria-pressed',String(mode==='seller'));window.scrollTo({top:0,behavior:'smooth'})}
  $('buyer-mode').addEventListener('click',()=>switchMode('buyer'));
  $('seller-mode').addEventListener('click',()=>switchMode('seller'));
  $('cart-open').addEventListener('click',()=>{renderCart();openModal('cart-modal')});
  document.querySelectorAll('.modal-close').forEach(b=>b.addEventListener('click',()=>closeModal(b.closest('.modal-backdrop').id)));
  document.querySelectorAll('.modal-backdrop').forEach(modal=>modal.addEventListener('click',e=>{if(e.target===modal)closeModal(modal.id)}));
  document.addEventListener('keydown',e=>{if(e.key==='Escape'){const open=document.querySelector('.modal-backdrop:not([hidden])');if(open)closeModal(open.id)}});
  $('add-to-cart').addEventListener('click',()=>{
    const p=state.products.find(x=>x.id===detailId);if(!p)return;
    const quantity=Number($('detail-quantity').value),existing=state.cart.find(x=>x.id===p.id);
    if(!Number.isInteger(quantity)||quantity<1||quantity+(existing?.quantity||0)>p.stock){toast('수량을 확인해 주세요. 재고를 초과할 수 없습니다.');return}
    if(existing)existing.quantity+=quantity;else state.cart.push({id:p.id,quantity});
    persist();renderCart();closeModal('detail-modal');toast('장바구니에 담았습니다.')
  });
  $('category-form').addEventListener('submit',e=>{
    e.preventDefault();const name=$('category-name').value.trim();if(!name)return;
    if(state.categories.some(c=>c.name.toLowerCase()===name.toLowerCase()&&c.id!==editingCategory)){toast('이미 있는 카테고리 이름입니다.');return}
    if(editingCategory){const c=state.categories.find(x=>x.id===editingCategory);if(c)c.name=name}else state.categories.push({id:uid(),name});
    resetCategoryForm();persist();renderAll();toast('카테고리를 저장했습니다.')
  });
  $('category-cancel').addEventListener('click',resetCategoryForm);
  $('product-form').addEventListener('submit',e=>{
    e.preventDefault();
    const price=Number($('product-price').value),stock=Number($('product-stock').value),image=$('product-image').value.trim();
    if(!Number.isSafeInteger(price)||price<0||!Number.isSafeInteger(stock)||stock<0||!/^https:\/\/\S+$/i.test(image)){toast('가격, 재고 및 HTTPS 이미지 주소를 확인해 주세요.');return}
    const values={name:$('product-name').value.trim(),categoryId:$('product-category').value,price,stock,image,description:$('product-description').value.trim()};
    if(!values.name||!values.description){toast('상품명과 설명을 입력해 주세요.');return}
    if(editingProduct){const p=state.products.find(x=>x.id===editingProduct);if(p)Object.assign(p,values)}else state.products.push({id:uid(),...values});
    resetProductForm();persist();renderAll();toast('상품을 저장했습니다.')
  });
  $('product-cancel').addEventListener('click',resetProductForm);
  $('checkout').addEventListener('click',()=>{
    cleanCart();if(!state.cart.length){renderCart();toast('장바구니가 비어 있습니다.');return}
    const items=[];
    for(const item of state.cart){const p=state.products.find(x=>x.id===item.id);if(!p||p.stock<item.quantity){renderCart();toast('재고가 변경되었습니다. 장바구니를 확인해 주세요.');return}items.push({id:p.id,name:p.name,price:p.price,quantity:item.quantity})}
    const order={id:'P404-'+Date.now().toString(36).toUpperCase(),createdAt:new Date().toISOString(),items,total:items.reduce((sum,i)=>sum+i.price*i.quantity,0)};
    const snapshot=JSON.stringify(state);
    for(const item of items)state.products.find(p=>p.id===item.id).stock-=item.quantity;
    state.orders.push(order);state.cart=[];
    if(!persist()){state=JSON.parse(snapshot);renderAll();return}
    renderAll();closeModal('cart-modal');
    $('success-order').textContent=`주문번호 ${order.id}`;$('success-total').textContent=`결제 예정 금액 ${won(order.total)}`;
    const qrText=JSON.stringify({orderId:order.id,total:order.total,createdAt:order.createdAt});
    const canvas=$('order-qr');$('qr-fallback').hidden=true;$('qr-holder').hidden=false;
    if(window.QRCode?.toCanvas)window.QRCode.toCanvas(canvas,qrText,{width:190,margin:1},err=>{if(err){$('qr-holder').hidden=true;$('qr-fallback').hidden=false}});
    else{$('qr-holder').hidden=true;$('qr-fallback').hidden=false}
    openModal('success-modal')
  });
  $('success-close').addEventListener('click',()=>closeModal('success-modal'));
  renderAll();
})();
</script>
 
</body></html>
